}



\newcounter{stepnum}

%% Optional argument for an italicized pre-step
%% Also use obeylines to minimize markup here as well
\newenvironment{method}[1][]{%
    \setcounter{stepnum}{0}
    \noindent
    {\large\textbf{Instructions}}%
    \par
    \smallskip
    \if###1##%
    \else
        \noindent
        \emph{#1}
        \par
    \fi
    \begingroup
    \rightskip0pt plus 3em
    \parindent0pt
    \parskip0.25em
        \leftskip2em
    \everypar={\llap{\stepcounter{stepnum}\hbox to2em{\thestepnum.\hfill}}}
}{%
    \par
    \endgroup
    }

    \makeatother


% --- Dictionary formatting -------------------------------------------------
% (See note below: this block is a good candidate for formatting.sty.)

% Letter divider, e.g. \dictletter{N}
\newcommand{\dictletter}[1]{%
  \par\addvspace{1.3ex}%
  {\large\bfseries\color{Maroon}#1}\enspace{\color{Maroon}\hrulefill}\par
  \nobreak\vspace{0.5ex}%
}

% \entry{headword}[label]{definition}[example]
%   label and example are optional (note the square brackets).
\NewDocumentCommand{\entry}{m o m o}{%
  \par\hangindent=1.3em\hangafter=1\relax
  {\bfseries\color{Maroon}#1}%
  \IfValueT{#2}{\enskip{\itshape\color{gray}#2}}%  % was \enspace
  \enskip #3%                                       % was \enspace  <- the crucial one
  \IfValueT{#4}{\newline{\itshape #4}}%
  \par\addvspace{0.55ex}%
}

